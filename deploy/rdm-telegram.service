[Unit]
Description=RealDarkMeme Telegram authorization queue worker
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/realdarkmeme
ExecStart=/usr/bin/php artisan queue:work database --queue=telegram --sleep=1 --tries=1 --timeout=110 --memory=256
Restart=always
RestartSec=5
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
