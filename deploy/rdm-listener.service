[Unit]
Description=RealDarkMeme Telegram channel listener (MadelineProto)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/realdarkmeme-laravel
ExecStart=/usr/bin/php artisan rdm:listen
Restart=always
RestartSec=8
TimeoutStopSec=90
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
